# Copy to .env in the project root. Never commit real credentials.
MODEL_PATH=weights/drone_detector.pt
CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.50
IMAGE_SIZE=1280
DEVICE=auto
TRACKER=bytetrack
TRACK_BUFFER=60
LOST_TIMEOUT_S=3.0
MATCH_THRESHOLD=0.80
MAX_TRAJECTORY_POINTS=50
TARGET_FPS=30
FRAME_SKIP=0
STREAM_WIDTH=1280
JPEG_QUALITY=80
MAX_DETECTIONS=100
DEBUG=false
# Comma-separated model class names. Empty means all classes in the model.
CLASSES=
# Example format only. Replace locally, then restart backend:
RTSP_URL=
MAX_UPLOAD_MB=250
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Optional absolute directory for local observations/config/uploads:
# SWARM_DATA_DIR=
